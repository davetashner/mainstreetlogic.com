---
import { withBase } from '../lib/url';
import BaseLayout from '../layouts/BaseLayout.astro';

const principles = [
  {
    title: 'I listen first',
    description:
      'Every business is different. Before I recommend anything, I learn how your days actually run, what gets in the way, and what you can spend.',
  },
  {
    title: 'I keep it simple',
    description:
      'Technology should make your day easier. I favor tools that are easy to maintain and that your team will actually use.',
  },
  {
    title: 'I think long-term',
    description:
      'I’m not here to sell you something and disappear. I stick around, keep things running, and help you plan what comes next.',
  },
  {
    title: 'I stay honest',
    description:
      'If you don’t need something, I’ll tell you, even when the right answer is to change nothing.',
  },
];
---

<BaseLayout
  title="About"
  description="Main Street Logic is Dave Tashner, a developer in Central Virginia who builds software, automation, and websites for small businesses."
>
  <section class="page-head">
    <div class="wrap">
      <h1>Hi, I’m Dave.</h1>
      <p class="lede measure">
        Main Street Logic is me: one developer who builds practical software for
        small businesses and sticks around after it ships.
      </p>
    </div>
  </section>

  <section class="section story" aria-labelledby="story-title">
    <div class="wrap story-grid">
      <figure class="portrait">
        <div class="portrait-frame">
          <img
            src={withBase('/images/headshot.webp')}
            alt="Dave Tashner"
            width="886"
            height="886"
            loading="eager"
            decoding="async"
          />
        </div>
        <figcaption>Dave Tashner, founder</figcaption>
      </figure>
      <div class="measure">
        <h2 id="story-title">Why I started Main Street Logic</h2>
        <div class="prose">
          <p>
            I started Main Street Logic with a simple idea: small businesses
            shouldn’t have to figure out technology alone. Too often I saw local
            businesses stuck with outdated systems, paying for software they
            didn’t need, or missing chances because nobody had shown them what
            was possible.
          </p>
          <p>
            I began by helping a few businesses in my own community. Word
            spread, and it became clear there was real demand for technology
            help that speaks the language of small business owners: plain
            answers and practical fixes instead of jargon.
          </p>
          <p>
            Today I work with small businesses across the country, helping them
            make sound technology decisions that save time, cut costs, and leave
            room to grow.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section principles" aria-labelledby="principles-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="principles-title">How I work</h2>
      </div>
      <ul class="principle-list ruled">
        {
          principles.map((p) => (
            <li>
              <h3>{p.title}</h3>
              <p>{p.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section where" aria-labelledby="where-title">
    <div class="wrap where-grid">
      <h2 id="where-title">Where I work</h2>
      <div class="measure prose">
        <p>
          I’m based in Central Virginia. Most of my work happens remotely, so I
          can help your business wherever it is.
        </p>
        <p>
          If you’re nearby, I’m glad to meet in person when it’s useful: walking
          through your shop or office often shows me more than a call can.
        </p>
      </div>
    </div>
  </section>

  <section class="closing" aria-labelledby="closing-title">
    <div class="wrap">
      <h2 id="closing-title">Let’s see if I can help.</h2>
      <p class="lede measure">
        Tell me what’s slowing your business down. The first call is free and
        takes 30 minutes.
      </p>
      <div class="actions">
        <a href={withBase('/contact')} class="btn btn-lg">Book a free call</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .story-grid {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  @media (min-width: 48rem) {
    .story-grid {
      grid-template-columns: minmax(14rem, 4fr) 8fr;
      gap: clamp(2.5rem, 6vw, 5rem);
    }
  }

  .portrait {
    margin: 0;
    max-width: 20rem;
  }

  /* Oval cameo: a single olive ring set off from the photo by a sliver of paper. */
  .portrait-frame {
    aspect-ratio: 4 / 5;
    padding: 0.375rem;
    border: 3px solid var(--accent);
    border-radius: 50%;
    background: var(--paper);
    box-shadow: 0 1.25rem 2.5rem -1.25rem rgb(12 33 53 / 0.45);
  }

  .portrait img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
    border-radius: 50%;
  }

  .portrait figcaption {
    margin-top: 1.25rem;
    text-align: center;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .prose > * + * {
    margin-top: 1.125rem;
  }

  .story h2 {
    margin-bottom: 1.25rem;
  }

  .principles {
    background: var(--accent-soft);
  }

  .principle-list {
    border-block: 1px solid var(--rule);
  }

  .principle-list li {
    display: grid;
    gap: 0.5rem;
    padding-block: 1.5rem;
  }

  @media (min-width: 48rem) {
    .principle-list li {
      grid-template-columns: 5fr 7fr;
      gap: 2.5rem;
      align-items: baseline;
    }
  }

  .principle-list p {
    color: var(--muted);
    max-width: 36em;
  }

  .where-grid {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 60rem) {
    .where-grid {
      grid-template-columns: 4fr 8fr;
      gap: 4rem;
      align-items: baseline;
    }
  }

  .actions {
    margin-top: 2.25rem;
  }
</style>
