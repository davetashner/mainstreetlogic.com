---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ from '../components/FAQ.astro';
import type { FaqItem } from '../data/faqs';

const pageDescription =
  'Clear pricing for small business technology work: website hosting from $12 a month, project ranges, and The Backlog Model for ongoing improvements.';

const hostingPlans = [
  {
    title: 'Basic hosting',
    price: '$12',
    description: 'For a simple business website.',
    features: [
      'Static website hosting',
      'SSL certificate included',
      'CDN for fast loading',
      'Basic analytics',
      'Email support',
    ],
  },
  {
    title: 'Pro hosting',
    price: '$15',
    description: 'For sites that take messages or change often.',
    features: [
      'Everything in Basic',
      'Contact form handling',
      'Monthly backups',
      'Priority support',
      'Uptime monitoring',
    ],
    note: 'Most sites need this',
  },
];

const projectRanges = [
  {
    size: 'Small projects',
    price: '$500–$2,000',
    examples: 'Simple websites, basic automation, quick integrations',
  },
  {
    size: 'Medium projects',
    price: '$2,000–$10,000',
    examples: 'Custom applications, complex integrations, full site redesigns',
  },
  {
    size: 'Large projects',
    price: 'Custom quote',
    examples: 'Multi-system overhauls and complex requirements',
  },
];

const backlogSteps = [
  'I keep a prioritized list of improvements, features, and fixes for your systems.',
  'You decide what matters most and set the order.',
  'I work through the list at a pace that fits your budget.',
  'Your systems keep getting better, without a big up-front investment.',
];

const faqs: FaqItem[] = [
  {
    question: 'How does project pricing work?',
    answer:
      "For defined projects I give a fixed-price quote; for open-ended work I bill hourly. After the free call, you'll get a written estimate so there are no surprises.",
  },
  {
    question: 'What is The Backlog Model?',
    answer:
      'For ongoing clients, I keep a prioritized list of improvements and features for your systems. You control the priorities, and I work through them as your budget allows. You get predictable costs and steady improvement.',
  },
  {
    question: 'Do you offer monthly retainers?',
    answer:
      'Yes. If you need ongoing support, a monthly retainer reserves my time for you and usually comes with a lower hourly rate.',
  },
  {
    question: "What's included in the free call?",
    answer:
      "Thirty minutes to learn about your business and what's slowing you down, and to decide together whether I'm the right person to help. No pressure and no obligation.",
  },
  {
    question: "What if I'm not happy with the work?",
    answer:
      "If you're not happy with our first project, I'll make it right. No questions asked.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---

<BaseLayout title="Pricing" description={pageDescription}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <section class="intro">
    <div class="wrap">
      <h1>Pricing</h1>
      <p class="lede measure">
        No hidden fees and no surprise invoices. Here's what hosting costs, what
        projects usually run, and how ongoing work is billed.
      </p>
    </div>
  </section>

  <section class="section block" aria-labelledby="hosting-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="hosting-title">Website hosting</h2>
        <p class="lede measure">
          I keep your site online, secure, and fast. Billed monthly, cancel any
          time.
        </p>
      </div>
      <div class="plans">
        {
          hostingPlans.map((plan, i) => (
            <section class="plan" aria-labelledby={`plan-${i}`}>
              <div class="plan-head">
                <h3 id={`plan-${i}`}>{plan.title}</h3>
                {plan.note && <p class="plan-note">{plan.note}</p>}
              </div>
              <p class="price">
                <span class="amount">{plan.price}</span>
                <span class="per">per month</span>
              </p>
              <p class="plan-desc">{plan.description}</p>
              <ul class="features">
                {plan.features.map((f) => (
                  <li>{f}</li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section block" aria-labelledby="projects-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="projects-title">Project work</h2>
        <p class="lede measure">
          Every project gets its own written quote. These ranges give you a
          sense of scale before we talk.
        </p>
      </div>
      <dl class="ranges ruled">
        {
          projectRanges.map((r) => (
            <div class="range">
              <dt>{r.size}</dt>
              <dd class="range-price">{r.price}</dd>
              <dd class="range-examples">{r.examples}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section backlog" aria-labelledby="backlog-title">
    <div class="wrap backlog-grid">
      <div>
        <h2 id="backlog-title">The Backlog Model</h2>
        <p class="lede">
          Technology needs don't stop after launch. This is how I handle ongoing
          improvements.
        </p>
      </div>
      <ol class="backlog-steps">
        {backlogSteps.map((step) => <li>{step}</li>)}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="wrap faq-grid">
      <h2 id="faq-title">Pricing questions</h2>
      <FAQ items={faqs} />
    </div>
  </section>

  <section class="closing" aria-labelledby="closing-title">
    <div class="wrap">
      <h2 id="closing-title">Get a quote for your project.</h2>
      <p class="lede measure">
        Start with a free 30-minute call. I'll follow up with a written
        estimate, and there's no obligation to go ahead.
      </p>
      <div class="actions">
        <a href="/contact" class="btn btn-lg">Book a free call</a>
        <a href="/services" class="quiet">See services</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    padding-block: clamp(3rem, 2rem + 5vw, 6rem) clamp(1rem, 0.5rem + 2vw, 2rem);
  }

  .intro .lede {
    margin-top: 1.5rem;
  }

  .block + .block {
    padding-top: 0;
  }

  .plans {
    display: grid;
    border-block: 2px solid var(--ink);
  }

  @media (min-width: 48rem) {
    .plans {
      grid-template-columns: 1fr 1fr;
    }

    .plan + .plan {
      border-left: 1px solid var(--rule);
      padding-left: clamp(2rem, 4vw, 3.5rem);
    }

    .plan:first-child {
      padding-right: clamp(2rem, 4vw, 3.5rem);
    }
  }

  @media (max-width: 47.99rem) {
    .plan + .plan {
      border-top: 1px solid var(--rule);
    }
  }

  .plan {
    padding-block: 2rem;
  }

  .plan-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }

  .plan-note {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--accent);
  }

  .price {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .amount {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 3.5rem;
    line-height: 1;
    color: var(--ink);
  }

  .per {
    color: var(--muted);
  }

  .plan-desc {
    margin-top: 0.75rem;
    color: var(--muted);
  }

  .features {
    margin-top: 1.25rem;
    display: grid;
    gap: 0.5rem;
  }

  .features li {
    position: relative;
    padding-left: 1.25rem;
  }

  .features li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 0.5rem;
    height: 2px;
    background: var(--accent);
  }

  .ranges {
    border-block: 1px solid var(--rule);
  }

  .range {
    display: grid;
    gap: 0.25rem;
    padding-block: 1.5rem;
  }

  @media (min-width: 48rem) {
    .range {
      grid-template-columns: 4fr 3fr 5fr;
      gap: 2rem;
      align-items: baseline;
    }
  }

  .range dt {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    font-weight: 600;
  }

  .range-price {
    font-family: var(--font-serif);
    font-size: 1.625rem;
    font-weight: 700;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .range-examples {
    color: var(--muted);
  }

  .backlog {
    background: var(--accent-soft);
  }

  .backlog-grid {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 60rem) {
    .backlog-grid {
      grid-template-columns: 5fr 7fr;
      gap: 4rem;
      align-items: start;
    }
  }

  .backlog .lede {
    margin-top: 1rem;
  }

  .backlog-steps {
    counter-reset: step;
    display: grid;
    gap: 1.5rem;
  }

  .backlog-steps li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1rem;
    align-items: baseline;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
  }

  .backlog-steps li::before {
    content: counter(step);
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 2rem;
    line-height: 1;
    color: var(--accent);
  }

  .faq-grid {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 60rem) {
    .faq-grid {
      grid-template-columns: 4fr 8fr;
      gap: 4rem;
      align-items: start;
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 2.25rem;
  }

  .quiet {
    font-weight: 600;
    color: #fefdf8;
    padding-block: 0.5rem;
  }
</style>
