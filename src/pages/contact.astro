---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact"
  description="Get in touch with Dave Tashner at Main Street Logic. Send a message or book a free 30-minute call."
>
  <section class="page-head">
    <div class="wrap">
      <h1>Book a free call.</h1>
      <p class="lede measure">
        Tell me a little about your business and what’s getting in the way. I’ll
        reply within one business day to set up a 30-minute call.
      </p>
    </div>
  </section>

  <section class="section contact">
    <div class="wrap contact-grid">
      <div>
        <h2 class="form-title">Send a message</h2>
        <form id="contact-form" class="form">
          <div>
            <label for="name" class="form-label">Name</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              autocomplete="name"
              class="form-input"
            />
          </div>

          <div>
            <label for="email" class="form-label">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              class="form-input"
            />
          </div>

          <div>
            <label for="business" class="form-label"
              >Business name <span class="form-hint">(optional)</span></label
            >
            <input
              type="text"
              id="business"
              name="business"
              autocomplete="organization"
              class="form-input"
            />
          </div>

          <div>
            <label for="message" class="form-label">What can I help with?</label
            >
            <textarea
              id="message"
              name="message"
              required
              rows="6"
              placeholder="For example: we retype every online order into QuickBooks by hand."
              class="form-input form-textarea"></textarea>
          </div>

          <!-- Honeypot field - hidden from users, bots will fill it -->
          <div class="hidden" aria-hidden="true">
            <label for="website">Website</label>
            <input
              type="text"
              id="website"
              name="website"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <!-- Status message -->
          <div id="form-status" class="hidden" role="status" aria-live="polite">
            <p id="form-loading" class="hidden status status-loading">
              Sending your message…
            </p>
            <p id="form-success" class="hidden status status-success">
              Thanks, your message is on its way. I’ll reply within one business
              day.
            </p>
            <p id="form-error" class="hidden status status-error">
              <span id="error-message"
                >The message didn’t send. Please try again.</span
              >
            </p>
          </div>

          <div>
            <button type="submit" id="submit-button" class="btn btn-lg">
              Send message
            </button>
          </div>
        </form>
      </div>

      <aside class="side" aria-label="Other ways to reach me">
        <div>
          <h2>Email me directly</h2>
          <p>
            <a href="mailto:hello@mainstreetlogic.com"
              >hello@mainstreetlogic.com</a
            >
          </p>
        </div>
        <div>
          <h2>What happens next</h2>
          <p>
            I reply within one business day. If it looks like I can help, we’ll
            set up a free 30-minute call to talk it through, whether or not you
            end up working with me.
          </p>
        </div>
        <div>
          <h2>If something’s urgent</h2>
          <p>Say so in your message and I’ll get to it first.</p>
        </div>
        <div>
          <h2>My promise</h2>
          <p>If you’re not happy with our first project, I’ll make it right.</p>
        </div>
      </aside>
    </div>
  </section>

  <script>
    const CONTACT_API_URL = import.meta.env.PUBLIC_CONTACT_API_URL || '';

    const form = document.getElementById('contact-form') as HTMLFormElement;
    const submitButton = document.getElementById(
      'submit-button'
    ) as HTMLButtonElement;
    const statusContainer = document.getElementById(
      'form-status'
    ) as HTMLDivElement;
    const loadingEl = document.getElementById('form-loading') as HTMLDivElement;
    const successEl = document.getElementById('form-success') as HTMLDivElement;
    const errorEl = document.getElementById('form-error') as HTMLDivElement;
    const errorMessage = document.getElementById(
      'error-message'
    ) as HTMLSpanElement;

    function showStatus(
      type: 'loading' | 'success' | 'error',
      message?: string
    ) {
      statusContainer.classList.remove('hidden');
      loadingEl.classList.add('hidden');
      successEl.classList.add('hidden');
      errorEl.classList.add('hidden');

      if (type === 'loading') {
        loadingEl.classList.remove('hidden');
      } else if (type === 'success') {
        successEl.classList.remove('hidden');
      } else if (type === 'error') {
        errorEl.classList.remove('hidden');
        if (message) {
          errorMessage.textContent = message;
        }
      }
    }

    function hideStatus() {
      statusContainer.classList.add('hidden');
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (!CONTACT_API_URL) {
        showStatus(
          'error',
          'The contact form isn’t set up yet. Please email hello@mainstreetlogic.com directly.'
        );
        return;
      }

      const formData = new FormData(form);
      const data = {
        name: formData.get('name'),
        email: formData.get('email'),
        business: formData.get('business'),
        message: formData.get('message'),
        website: formData.get('website'), // honeypot
      };

      submitButton.disabled = true;
      showStatus('loading');

      try {
        const response = await fetch(CONTACT_API_URL, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(data),
        });

        const result = await response.json();

        if (response.ok && result.success) {
          showStatus('success');
          form.reset();
        } else {
          showStatus(
            'error',
            result.error || 'Failed to send message. Please try again.'
          );
        }
      } catch (err) {
        console.error('Contact form error:', err);
        showStatus(
          'error',
          'Network error. Please check your connection and try again.'
        );
      } finally {
        submitButton.disabled = false;
      }
    });
  </script>
</BaseLayout>

<style>
  .contact {
    padding-top: clamp(2.5rem, 2rem + 3vw, 4rem);
  }

  .contact-grid {
    display: grid;
    gap: 3.5rem;
  }

  @media (min-width: 60rem) {
    .contact-grid {
      grid-template-columns: 7fr 4fr;
      gap: 5rem;
      align-items: start;
    }
  }

  .form-title {
    font-size: 1.75rem;
    margin-bottom: 1.5rem;
  }

  .form {
    display: grid;
    gap: 1.5rem;
    max-width: 36rem;
  }

  .status {
    padding: 0.875rem 1rem;
    border-radius: 0.375rem;
    border-left: 4px solid;
    font-size: 1rem;
  }

  .status-loading {
    border-color: var(--rule);
    color: var(--muted);
  }

  .status-success {
    border-color: var(--green);
    background: var(--green-soft);
  }

  .status-error {
    border-color: #b42318;
    background: color-mix(in srgb, #b42318 10%, var(--paper));
  }

  :global(.dark) .status-error {
    border-color: #f97066;
  }

  .side {
    display: grid;
    gap: 1.75rem;
    border-top: 2px solid var(--ink);
    padding-top: 1.5rem;
  }

  .side h2 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.375rem;
  }

  .side p {
    color: var(--muted);
  }

  .side a {
    font-weight: 600;
    overflow-wrap: anywhere;
  }
</style>
