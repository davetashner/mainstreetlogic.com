---
import BaseLayout from '../layouts/BaseLayout.astro';
import Receipt from '../components/Receipt.astro';
import SupplyCheckout from '../components/SupplyCheckout.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import FAQ from '../components/FAQ.astro';
import { services } from '../data/services';

const siteUrl = 'https://mainstreetlogic.com';
const pageDescription =
  'Custom software, automation, and websites for small businesses, from a developer in Central Virginia. Work directly with the person who builds it.';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Main Street Logic',
  description:
    'Custom software, automation, system integration, and websites for small businesses.',
  url: siteUrl,
  logo: `${siteUrl}/logo.png`,
  email: 'hello@mainstreetlogic.com',
  founder: { '@type': 'Person', name: 'Dave Tashner' },
  address: {
    '@type': 'PostalAddress',
    addressRegion: 'VA',
    addressCountry: 'US',
  },
  areaServed: { '@type': 'Country', name: 'United States' },
  priceRange: '$$',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Services',
    itemListElement: services.map((s) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: s.title,
        description: s.summary,
      },
    })),
  },
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Main Street Logic',
  url: siteUrl,
};
---

<BaseLayout title="Home" description={pageDescription}>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizationSchema)}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(websiteSchema)}
    />
  </Fragment>

  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1>You didn’t open a business to fight with software.</h1>
        <p class="lede measure">
          I'm Dave Tashner, a developer in Central Virginia. I build the small
          tools, automations, and websites that take busywork off your plate,
          and I stay on to keep them working.
        </p>
        <div class="hero-actions">
          <a href="/contact" class="btn btn-lg">Book a free 30-minute call</a>
          <a href="#work" class="see-work">See something I built</a>
        </div>
      </div>
      <div class="hero-art">
        <img
          src="/images/brand/storefront-light.webp"
          alt="A brick storefront and two neighboring shops on a small-town main street, with a lit lamppost and trees."
          width="552"
          height="336"
          fetchpriority="high"
          class="art-light"
        />
        <img
          src="/images/brand/storefront-dark.webp"
          alt="The same main street storefronts at night, windows glowing under a lit lamppost."
          width="552"
          height="337"
          class="art-dark"
        />
      </div>
    </div>
  </section>

  <section class="section services" aria-labelledby="services-title">
    <div class="wrap services-grid">
      <div class="services-intro">
        <h2 id="services-title">What I can take off your plate</h2>
        <p class="lede">
          Practical help sized for a small business: no enterprise software, no
          six-month roadmaps.
        </p>
        <Receipt />
      </div>
      <div>
        <ul class="service-list ruled">
          {
            services.map((s) => (
              <li>
                <h3>{s.title}</h3>
                <p>{s.summary}</p>
              </li>
            ))
          }
        </ul>
        <p class="more">
          <a href="/services">What each service includes</a>
        </p>
      </div>
    </div>
  </section>

  <section id="work" class="section work-band" aria-label="Recent work">
    <div class="wrap">
      <SupplyCheckout />
    </div>
  </section>

  <section class="section" aria-labelledby="process-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="process-title">How working together goes</h2>
      </div>
      <ProcessSteps />
    </div>
  </section>

  <section class="section faq-section" aria-labelledby="faq-title">
    <div class="wrap faq-grid">
      <h2 id="faq-title">Questions people ask first</h2>
      <FAQ />
    </div>
  </section>

  <section class="closing" aria-labelledby="closing-title">
    <div class="wrap">
      <h2 id="closing-title">Tell me what’s eating your week.</h2>
      <p class="lede measure">
        A free 30-minute call. If I'm not the right fit, I'll say so and point
        you somewhere better. If you're not happy with our first project, I'll
        make it right.
      </p>
      <div class="hero-actions">
        <a href="/contact" class="btn btn-lg">Book a free call</a>
        <a href="mailto:hello@mainstreetlogic.com" class="see-work"
          >Or email hello@mainstreetlogic.com</a
        >
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(3rem, 2rem + 5vw, 6.5rem) clamp(4rem, 3rem + 5vw, 7rem);
  }

  .hero-grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 60rem) {
    .hero-grid {
      grid-template-columns: 6fr 6fr;
      gap: 3rem;
    }
  }

  .hero h1 {
    max-width: 13ch;
  }

  .hero .lede {
    margin-top: 1.75rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 2.25rem;
  }

  .see-work {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
    padding-block: 0.5rem;
  }

  .hero-art img {
    display: block;
    width: 100%;
    max-width: 34.5rem;
    height: auto;
    margin-inline: auto;
  }

  .art-dark {
    display: none !important;
    /* feather the night scene into the page's navy */
    mask-image: radial-gradient(
      ellipse 70% 75% at 50% 55%,
      #000 60%,
      transparent 100%
    );
  }

  :global(.dark) .art-light {
    display: none !important;
  }

  :global(.dark) .art-dark {
    display: block !important;
  }

  .services-grid {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 60rem) {
    .services-grid {
      grid-template-columns: 5fr 7fr;
      gap: 4.5rem;
      align-items: start;
    }
  }

  .services-intro .lede {
    margin-top: 1rem;
    margin-bottom: 2.5rem;
  }

  .services {
    padding-top: 0;
  }

  .service-list {
    border-block: 1px solid var(--rule);
  }

  .service-list li {
    display: grid;
    gap: 0.375rem;
    padding-block: 1.5rem;
  }

  .service-list p {
    color: var(--muted);
    max-width: 36em;
  }

  .more {
    margin-top: 1.75rem;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
  }

  .work-band {
    background: var(--accent-soft);
    scroll-margin-top: 1rem;
  }

  .faq-section {
    padding-top: 0;
  }

  .faq-grid {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 60rem) {
    .faq-grid {
      grid-template-columns: 4fr 8fr;
      gap: 4rem;
      align-items: start;
    }
  }

  .closing .see-work {
    color: #fefdf8;
  }
</style>
