---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQ from '../../components/FAQ.astro';

const pageDescription =
  'Get 50% off your first year of website hosting with Main Street Logic. Enter your email to get the discount code.';

const benefits = [
  {
    title: 'Fast',
    description:
      'Your site is served from a global CDN, so pages load quickly on any phone.',
  },
  {
    title: 'Secure',
    description:
      'An SSL certificate is included. Pro adds monthly backups and uptime monitoring.',
  },
  {
    title: 'Managed',
    description: 'Updates and security patches are handled for you.',
  },
  {
    title: 'Direct support',
    description:
      'You talk to the developer who runs your site, not a ticket queue.',
  },
];

const faqs = [
  {
    question: 'How long does the discount last?',
    answer:
      'The 50% discount covers your first 12 months. After that, hosting is the regular $15 a month.',
  },
  {
    question: 'Is there a contract?',
    answer:
      'No. Cancel any time with 30 days’ notice. You should stay because it works for you, not because you’re locked in.',
  },
  {
    question: 'Can I move an existing website?',
    answer:
      'Yes. The discount is for new hosting clients, and I’ll migrate your current site at no extra charge.',
  },
  {
    question: 'What if I need a new website too?',
    answer:
      'I build websites for small businesses, and this discount can be combined with a new site project.',
  },
];
---

<BaseLayout title="50% Off Hosting" description={pageDescription}>
  <section class="page-head">
    <div class="wrap head-grid">
      <div>
        <h1><span class="sign">50% Off</span> your first year of hosting</h1>
        <p class="lede measure">
          Website hosting without the headaches: no hidden fees, no long-term
          contract, and a real person to talk to.
        </p>
        <p class="price">
          <span class="was"><s>$15</s> a month</span>
          <span class="now">$7.50 a month for the first year</span>
        </p>
      </div>

      <div class="claim">
        <div id="form-container">
          <h2>Get your discount code</h2>
          <p class="claim-sub">Enter your email and I’ll send you the code.</p>
          <form id="discount-form" class="form">
            <div>
              <label for="email" class="form-label">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
                placeholder="you@example.com"
                class="form-input"
              />
            </div>

            <!-- Honeypot field - hidden from users, bots will fill it -->
            <div class="hidden" aria-hidden="true">
              <label for="website">Website</label>
              <input
                type="text"
                id="website"
                name="website"
                tabindex="-1"
                autocomplete="off"
              />
            </div>

            <p id="form-error" class="hidden status-error" role="alert">
              <span id="error-message"
                >Something went wrong. Please try again.</span
              >
            </p>

            <button type="submit" id="submit-button" class="btn btn-lg">
              <span id="button-text">Get my discount code</span>
              <svg
                id="button-spinner"
                class="hidden spinner"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
              >
                <circle
                  cx="12"
                  cy="12"
                  r="9"
                  stroke="currentColor"
                  stroke-width="3"
                  opacity="0.25"></circle>
                <path
                  d="M21 12a9 9 0 0 0-9-9"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"></path>
              </svg>
            </button>
            <p class="fine">I’ll only email you about this discount.</p>
          </form>
        </div>

        <div id="success-container" class="hidden" role="status">
          <h2>Here’s your code</h2>
          <p class="claim-sub">Use it when you sign up for hosting:</p>
          <!-- TODO: code says 2024; confirm it is still valid -->
          <p id="coupon-code" class="coupon">HALFOFF2024</p>
          <p class="fine">
            50% off your first year of hosting. New hosting clients only.
          </p>
          <a href="/contact" class="btn">Set up hosting</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="included-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="included-title">What’s included</h2>
      </div>
      <ul class="benefits ruled">
        {
          benefits.map((b) => (
            <li>
              <h3>{b.title}</h3>
              <p>{b.description}</p>
            </li>
          ))
        }
      </ul>
      <p class="more"><a href="/pricing">Compare hosting plans</a></p>
    </div>
  </section>

  <section class="section faq-section" aria-labelledby="faq-title">
    <div class="wrap faq-grid">
      <h2 id="faq-title">Common questions</h2>
      <FAQ items={faqs} />
    </div>
  </section>
</BaseLayout>

<script>
  const CONTACT_API_URL = import.meta.env.PUBLIC_CONTACT_API_URL || '';

  const form = document.getElementById('discount-form') as HTMLFormElement;
  const formContainer = document.getElementById(
    'form-container'
  ) as HTMLDivElement;
  const successContainer = document.getElementById(
    'success-container'
  ) as HTMLDivElement;
  const submitButton = document.getElementById(
    'submit-button'
  ) as HTMLButtonElement;
  const buttonText = document.getElementById('button-text') as HTMLSpanElement;
  const buttonSpinner = document.getElementById('button-spinner') as SVGElement;
  const errorEl = document.getElementById('form-error') as HTMLDivElement;
  const errorMessage = document.getElementById(
    'error-message'
  ) as HTMLSpanElement;

  function showError(message: string): void {
    errorEl.classList.remove('hidden');
    errorMessage.textContent = message;
  }

  function hideError(): void {
    errorEl.classList.add('hidden');
  }

  function setLoading(loading: boolean): void {
    submitButton.disabled = loading;
    if (loading) {
      buttonText.textContent = 'Sending…';
      buttonSpinner.classList.remove('hidden');
    } else {
      buttonText.textContent = 'Get my discount code';
      buttonSpinner.classList.add('hidden');
    }
  }

  function showSuccess(): void {
    formContainer.classList.add('hidden');
    successContainer.classList.remove('hidden');
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideError();

    const formData = new FormData(form);
    const email = formData.get('email') as string;
    const website = formData.get('website') as string; // honeypot

    // Basic email validation
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(email)) {
      showError('Please enter a valid email address.');
      return;
    }

    if (!CONTACT_API_URL) {
      // Fallback: Show success anyway if API not configured (for testing)
      showSuccess();
      return;
    }

    setLoading(true);

    try {
      const response = await fetch(CONTACT_API_URL, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          name: 'Hosting Discount Request',
          email: email,
          message:
            'Requested 50% hosting discount code via /resources/hosting-discount page.',
          website: website, // honeypot
        }),
      });

      const result = await response.json();

      if (response.ok && result.success) {
        showSuccess();
      } else {
        showError(result.error || 'Failed to submit. Please try again.');
      }
    } catch (err) {
      console.error('Discount form error:', err);
      showError('Network error. Please check your connection and try again.');
    } finally {
      setLoading(false);
    }
  });
</script>

<style>
  .head-grid {
    display: grid;
    gap: 3rem;
    align-items: start;
  }

  @media (min-width: 60rem) {
    .head-grid {
      grid-template-columns: 7fr 5fr;
      gap: 4rem;
    }
  }

  .sign {
    display: inline-block;
    background: var(--yellow);
    color: #13201a;
    padding: 0 0.2em;
    border-radius: 0.1em;
  }

  .page-head .lede {
    margin-top: 1.5rem;
  }

  .price {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    align-items: baseline;
    margin-top: 1.75rem;
    font-variant-numeric: tabular-nums;
  }

  .was {
    color: var(--muted);
  }

  .now {
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--green);
  }

  .claim {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-top: 4px solid var(--awning);
    border-radius: 0.375rem;
    padding: clamp(1.5rem, 1rem + 2vw, 2.25rem);
  }

  .claim h2 {
    font-size: 1.75rem;
  }

  .claim-sub {
    margin-top: 0.5rem;
    color: var(--muted);
  }

  .form {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .form .btn {
    width: 100%;
  }

  .fine {
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .status-error {
    padding: 0.75rem 1rem;
    border-left: 4px solid #b42318;
    border-radius: 0.375rem;
    background: color-mix(in srgb, #b42318 10%, var(--paper));
    font-size: 1rem;
  }

  .spinner {
    animation: spin 0.9s linear infinite;
  }

  @keyframes spin {
    to {
      rotate: 360deg;
    }
  }

  .coupon {
    margin-block: 1.25rem;
    padding: 1rem;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    border: 2px dashed var(--green);
    border-radius: 0.375rem;
    user-select: all;
  }

  #success-container .btn {
    margin-top: 1.5rem;
  }

  .benefits {
    border-block: 1px solid var(--rule);
  }

  .benefits li {
    display: grid;
    gap: 0.5rem;
    padding-block: 1.5rem;
  }

  @media (min-width: 48rem) {
    .benefits li {
      grid-template-columns: 5fr 7fr;
      gap: 2.5rem;
      align-items: baseline;
    }
  }

  .benefits p {
    color: var(--muted);
    max-width: 36em;
  }

  .more {
    margin-top: 1.75rem;
    font-weight: 600;
  }

  .faq-section {
    padding-top: 0;
  }

  .faq-grid {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 60rem) {
    .faq-grid {
      grid-template-columns: 4fr 8fr;
      gap: 4rem;
      align-items: start;
    }
  }
</style>
