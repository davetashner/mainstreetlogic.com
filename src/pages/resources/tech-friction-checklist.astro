---
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageDescription =
  'Free checklist to help small business owners identify technology friction in their operations. Find out where your tools are slowing you down.';

const checklistSections = [
  {
    title: 'Data entry and manual work',
    items: [
      'I enter the same information into multiple systems',
      'I copy data between spreadsheets regularly',
      'I manually send recurring emails or reminders',
      'I spend time formatting reports that could be automated',
      'I retype information from paper forms into digital systems',
    ],
  },
  {
    title: 'Tool integration',
    items: [
      'My tools don’t sync with each other automatically',
      'I export from one system to import into another',
      'Customer information exists in multiple disconnected places',
      'I use email to move data between team members',
      'When one system updates, I manually update others',
    ],
  },
  {
    title: 'Communication and workflow',
    items: [
      'Important updates get lost in email threads',
      'Team members ask “where is that file?” frequently',
      'I lack visibility into task/project status without asking',
      'Customer requests fall through the cracks sometimes',
      'Handoffs between team members cause delays or errors',
    ],
  },
  {
    title: 'Software subscriptions',
    items: [
      'I pay for features I don’t use in multiple tools',
      'I have overlapping tools that do similar things',
      'I’m locked into expensive software due to data',
      'Monthly SaaS costs keep creeping up',
      'I’m not sure what all my subscriptions cost monthly',
    ],
  },
  {
    title: 'Time drains',
    items: [
      'Routine tasks take longer than they should',
      'I spend time waiting for slow systems or loading',
      'Finding information requires searching multiple places',
      'I do the same troubleshooting steps repeatedly',
      'End-of-day/week/month closing takes hours of manual work',
    ],
  },
];
---

<BaseLayout title="Tech Friction Checklist" description={pageDescription}>
  <div class="checklist-page">
    <section class="page-head">
      <div class="wrap">
        <h1>Tech friction checklist</h1>
        <p class="lede measure">
          Find where technology is slowing your business down. Check each
          statement that sounds like your week, then see your score at the
          bottom.
        </p>
        <div class="head-actions no-print">
          <button type="button" id="print-button" class="btn-outline">
            Print or save as PDF
          </button>
          <p class="note">Free, and no email required.</p>
        </div>
      </div>
    </section>

    <section class="section list-section">
      <div class="wrap">
        <form id="checklist" class="sections" aria-describedby="score-live">
          {
            checklistSections.map((section, si) => (
              <fieldset class="group">
                <legend>{section.title}</legend>
                <ul>
                  {section.items.map((item, ii) => (
                    <li>
                      <input
                        type="checkbox"
                        id={`item-${si}-${ii}`}
                        name="friction"
                      />
                      <label for={`item-${si}-${ii}`}>{item}</label>
                    </li>
                  ))}
                </ul>
              </fieldset>
            ))
          }
        </form>

        <div class="score" aria-labelledby="score-title">
          <h2 id="score-title">Score your results</h2>
          <p id="score-live" class="score-live" aria-live="polite" hidden>
            You’ve checked <strong id="score-count">0</strong> of
            <span id="score-total">25</span> items.
          </p>
          <ul class="bands ruled">
            <li data-min="0" data-max="5">
              <span class="range">0–5 items</span>
              <span
                ><strong>Working well.</strong> Minor tune-ups are possible.</span
              >
            </li>
            <li data-min="6" data-max="12">
              <span class="range">6–12 items</span>
              <span
                ><strong>Moderate friction.</strong> A few integrations or automations
                could save real time.</span
              >
            </li>
            <li data-min="13" data-max="19">
              <span class="range">13–19 items</span>
              <span
                ><strong>High friction.</strong> You’re likely spending 5–10+ hours
                a week on work that could be automated.</span
              >
            </li>
            <li data-min="20" data-max="999">
              <span class="range">20+ items</span>
              <span
                ><strong>Critical friction.</strong> Technology is significantly holding
                your business back.</span
              >
            </li>
          </ul>
        </div>

        <div class="cta no-print">
          <h2>Checked more than five?</h2>
          <p class="lede measure">
            Let’s talk about which friction points cost you the most time and
            money, and how to fix them. The call is free and takes 30 minutes.
          </p>
          <a href="/contact" class="btn btn-lg">Book a free call</a>
        </div>

        <div class="print-footer">
          <p>
            <strong>Main Street Logic</strong>: software and automation for
            small businesses
          </p>
          <p>mainstreetlogic.com</p>
          <p>hello@mainstreetlogic.com</p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('checklist') as HTMLFormElement | null;
  const live = document.getElementById('score-live');
  const count = document.getElementById('score-count');
  const total = document.getElementById('score-total');
  const bands = document.querySelectorAll<HTMLLIElement>('.bands li');
  const boxes = form?.querySelectorAll<HTMLInputElement>(
    'input[type="checkbox"]'
  );

  function update() {
    if (!boxes || !count || !live) return;
    const n = Array.from(boxes).filter((b) => b.checked).length;
    count.textContent = String(n);
    live.hidden = false;
    bands.forEach((band) => {
      const min = Number(band.dataset.min);
      const max = Number(band.dataset.max);
      band.toggleAttribute('data-active', n >= min && n <= max);
    });
  }

  if (boxes && total) total.textContent = String(boxes.length);
  form?.addEventListener('change', update);
  document
    .getElementById('print-button')
    ?.addEventListener('click', () => window.print());
</script>

<style>
  .head-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 2rem;
  }

  .note {
    color: var(--muted);
    font-size: 1rem;
  }

  .list-section {
    padding-top: clamp(2.5rem, 2rem + 3vw, 4rem);
  }

  .sections {
    display: grid;
    gap: 2.75rem;
  }

  @media (min-width: 60rem) {
    .sections {
      grid-template-columns: 1fr 1fr;
      gap: 3rem 4rem;
    }
  }

  .group {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }

  .group legend {
    width: 100%;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.25;
    padding-bottom: 0.625rem;
    border-bottom: 2px solid var(--ink);
  }

  .group ul > li {
    display: flex;
    gap: 0.875rem;
    align-items: flex-start;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--rule);
  }

  .group input {
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.2rem;
    accent-color: var(--green);
    cursor: pointer;
  }

  .group label {
    cursor: pointer;
  }

  .score {
    margin-top: clamp(3.5rem, 3rem + 3vw, 5rem);
    max-width: 48rem;
  }

  .score-live {
    margin-top: 0.75rem;
    font-size: 1.1875rem;
  }

  .bands {
    margin-top: 1.5rem;
    border-block: 1px solid var(--rule);
  }

  .bands li {
    display: grid;
    gap: 0.25rem;
    padding: 1rem 0.75rem;
    margin-inline: -0.75rem;
    border-radius: 0.25rem;
  }

  @media (min-width: 40rem) {
    .bands li {
      grid-template-columns: 9rem 1fr;
      gap: 1.5rem;
    }
  }

  .bands li[data-active] {
    background: var(--green-soft);
    box-shadow: inset 4px 0 0 var(--yellow);
  }

  .range {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .bands li > span:last-child {
    color: var(--muted);
  }

  .bands strong {
    color: var(--ink);
  }

  .cta {
    margin-top: clamp(3.5rem, 3rem + 3vw, 5rem);
    padding-top: 2rem;
    border-top: 2px solid var(--ink);
  }

  .cta .lede {
    margin-block: 1rem 2rem;
  }

  .print-footer {
    display: none;
  }

  @media print {
    :global(header),
    :global(footer),
    :global(.awning),
    :global(.skip-link),
    .no-print {
      display: none !important;
    }

    :global(body) {
      background: white !important;
      color: #13201a !important;
      font-size: 11pt;
    }

    .page-head,
    .list-section {
      padding: 0 !important;
    }

    .sections {
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem 2rem;
      margin-top: 1rem;
    }

    .group {
      break-inside: avoid;
    }

    .group ul > li {
      padding-block: 0.3rem;
    }

    .score {
      margin-top: 1.25rem;
      break-inside: avoid;
    }

    .score-live {
      display: none;
    }

    .bands li {
      margin-inline: 0;
      padding-inline: 0;
    }

    .bands li[data-active] {
      background: none;
      box-shadow: none;
    }

    .print-footer {
      display: block;
      margin-top: 1.5rem;
      padding-top: 0.75rem;
      border-top: 1px solid #999;
      font-size: 9pt;
      text-align: center;
      color: #444;
    }
  }
</style>
