---
import { withBase } from '../lib/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import SupplyCheckout from '../components/SupplyCheckout.astro';
import { services } from '../data/services';

const pageDescription =
  'Automation, system integration, custom tools, websites, software cost check-ups, and hourly tech help for small businesses. Work directly with the developer.';

const demoUrl = 'https://supplycheckout.com/demo';

const comparisons = [
  {
    option: 'An agency',
    goodFor:
      'Large projects that need designers, developers, and a project manager at once.',
    tradeoff:
      'You talk to an account manager, and the person building your project changes from job to job.',
  },
  {
    option: 'A freelancer',
    goodFor: 'A single, well-defined job with a specialist skill.',
    tradeoff:
      'Many move on after delivery, so fixes and changes mean finding someone new.',
  },
  {
    option: 'Hiring in-house',
    goodFor: 'Businesses with enough technology work to fill a full-time job.',
    tradeoff:
      'Salary, benefits, recruiting, and management, even in the slow months.',
  },
  {
    option: 'Doing it yourself',
    goodFor: 'Small fixes when you enjoy learning the tools.',
    tradeoff:
      'Every hour spent figuring out software is an hour not spent running your business.',
  },
];
---

<BaseLayout title="Services" description={pageDescription}>
  <section class="intro">
    <div class="wrap">
      <h1>Services</h1>
      <p class="lede measure">
        Six ways I help small businesses spend less time on software and more
        time on the work they opened for. Every project starts with a free
        30-minute call.
      </p>
      <nav class="jump" aria-label="Services on this page">
        <ul>
          {
            services.map((s) => (
              <li>
                <a href={`#${s.slug}`}>{s.title}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>

  <div class="wrap">
    <div class="service-list ruled">
      {
        services.map((s) => (
          <section
            id={s.slug}
            class="service"
            aria-labelledby={`${s.slug}-title`}
          >
            <div class="service-head">
              <h2 id={`${s.slug}-title`}>{s.title}</h2>
              <p class="summary">{s.summary}</p>
            </div>
            <div class="service-body">
              <h3>Usually includes</h3>
              <ul class="includes">
                {s.includes.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              <p class="example">
                <strong>For example:</strong>{' '}
                {s.slug === 'custom-tools' ? (
                  <>
                    Supply Checkout, a barcode app that replaced a paper
                    sign-out sheet.{' '}
                    <a href={demoUrl} target="_blank" rel="noopener">
                      Try the demo
                    </a>
                  </>
                ) : (
                  s.example
                )}
              </p>
            </div>
          </section>
        ))
      }
    </div>
  </div>

  <section class="section work-band" aria-label="Recent work">
    <div class="wrap">
      <SupplyCheckout headingLevel="h2" />
    </div>
  </section>

  <section class="section" aria-labelledby="compare-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="compare-title">How I compare to your other options</h2>
        <p class="lede measure">
          Every option has its place. I'm a good fit when you want one person
          who knows your business, builds the thing, and is still around next
          year.
        </p>
      </div>
      <div class="table-scroll">
        <table class="compare">
          <thead>
            <tr>
              <th scope="col">Option</th>
              <th scope="col">Good for</th>
              <th scope="col">The trade-off</th>
            </tr>
          </thead>
          <tbody>
            {
              comparisons.map((c) => (
                <tr>
                  <th scope="row">{c.option}</th>
                  <td>{c.goodFor}</td>
                  <td>{c.tradeoff}</td>
                </tr>
              ))
            }
          </tbody>
          <tfoot>
            <tr>
              <th scope="row">Working with me</th>
              <td>
                Small businesses that want ongoing help without a full-time
                hire.
              </td>
              <td>
                I'm one person, so large or rush projects get scheduled around
                work already underway.
              </td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  </section>

  <section class="closing" aria-labelledby="closing-title">
    <div class="wrap">
      <h2 id="closing-title">Not sure which of these you need?</h2>
      <p class="lede measure">
        That's what the free call is for. Tell me what's slowing you down, and
        I'll tell you honestly whether I can help. If you're not happy with our
        first project, I'll make it right.
      </p>
      <div class="actions">
        <a href={withBase('/contact')} class="btn btn-lg">Book a free call</a>
        <a href={withBase('/pricing')} class="quiet">See pricing</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    padding-block: clamp(3rem, 2rem + 5vw, 6rem) clamp(2.5rem, 2rem + 3vw, 4rem);
  }

  .intro .lede {
    margin-top: 1.5rem;
  }

  .jump ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 2rem;
    font-size: 1rem;
    font-weight: 600;
  }

  .jump a {
    display: inline-block;
    padding-block: 0.375rem;
    color: var(--ink);
  }

  .service-list {
    border-block: 1px solid var(--rule);
    margin-bottom: clamp(4rem, 3rem + 5vw, 7rem);
  }

  .service {
    display: grid;
    gap: 1.5rem;
    padding-block: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    scroll-margin-top: 1rem;
  }

  @media (min-width: 52rem) {
    .service {
      grid-template-columns: 5fr 7fr;
      gap: 3rem;
    }
  }

  .service h2 {
    font-size: clamp(1.625rem, 1.3rem + 1.2vw, 2.125rem);
  }

  .summary {
    margin-top: 0.875rem;
    color: var(--muted);
    max-width: 30em;
  }

  .service-body h3 {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 700;
    color: var(--muted);
  }

  .includes {
    margin-top: 0.75rem;
    display: grid;
    gap: 0.5rem;
    max-width: 36em;
  }

  .includes li {
    position: relative;
    padding-left: 1.25rem;
  }

  .includes li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 0.5rem;
    height: 2px;
    background: var(--accent);
  }

  .example {
    margin-top: 1.5rem;
    padding-left: 1rem;
    border-left: 3px solid var(--accent);
    max-width: 36em;
  }

  .work-band {
    background: var(--accent-soft);
  }

  .table-scroll {
    overflow-x: auto;
  }

  .compare {
    width: 100%;
    border-collapse: collapse;
    font-size: 1.0625rem;
  }

  .compare th,
  .compare td {
    text-align: left;
    vertical-align: top;
    padding: 1.125rem 1.5rem 1.125rem 0;
    border-top: 1px solid var(--rule);
  }

  .compare thead th {
    border-top: none;
    padding-top: 0;
    font-size: 1rem;
    color: var(--muted);
    font-weight: 700;
  }

  .compare tbody th,
  .compare tfoot th {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .compare td {
    color: var(--muted);
  }

  .compare tfoot th,
  .compare tfoot td {
    border-top: 2px solid var(--ink);
    color: var(--ink);
  }

  .compare tfoot th {
    color: var(--accent);
  }

  /* Stack rows on small screens instead of scrolling sideways */
  @media (max-width: 47.99rem) {
    .compare thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }

    .compare tr {
      display: block;
      border-top: 1px solid var(--rule);
      padding-block: 1.25rem;
    }

    .compare tfoot tr {
      border-top: 2px solid var(--ink);
    }

    .compare th,
    .compare td {
      display: block;
      border: none;
      padding: 0;
    }

    .compare td {
      margin-top: 0.5rem;
    }

    .compare td:nth-of-type(1)::before {
      content: 'Good for: ';
      font-weight: 700;
      color: var(--ink);
    }

    .compare td:nth-of-type(2)::before {
      content: 'The trade-off: ';
      font-weight: 700;
      color: var(--ink);
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 2.25rem;
  }

  .quiet {
    font-weight: 600;
    color: #fefdf8;
    padding-block: 0.5rem;
  }
</style>
