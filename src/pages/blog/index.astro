---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Blog"
  description="Practical writing on technology for small businesses, from Main Street Logic. Coming soon."
>
  <section class="page-head">
    <div class="wrap">
      <h1>Blog</h1>
      <p class="lede measure">
        Nothing posted yet. I’m writing plain-language articles on automation,
        software costs, and picking tools that fit a small business.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <ul class="next ruled">
        <li>
          <h2>In the meantime, try the checklist</h2>
          <div>
            <p>
              Twenty-five quick yes-or-no questions that show where technology
              is costing your business time.
            </p>
            <p class="link">
              <a href="/resources/tech-friction-checklist"
                >Open the tech friction checklist</a
              >
            </p>
          </div>
        </li>
        <li>
          <h2>Or ask me directly</h2>
          <div>
            <p>
              If you have a question you’d like to see answered here, send it
              over. I’ll answer you now and may write it up later.
            </p>
            <p class="link"><a href="/contact">Send a question</a></p>
          </div>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .next {
    border-block: 1px solid var(--rule);
  }

  .next li {
    display: grid;
    gap: 0.75rem;
    padding-block: 1.75rem;
  }

  @media (min-width: 48rem) {
    .next li {
      grid-template-columns: 5fr 7fr;
      gap: 2.5rem;
      align-items: baseline;
    }
  }

  .next h2 {
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .next p {
    color: var(--muted);
    max-width: 36em;
  }

  .next .link {
    margin-top: 0.75rem;
    font-weight: 600;
  }
</style>
