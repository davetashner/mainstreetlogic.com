---
import { withBase } from '../lib/url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
}

const siteUrl = 'https://mainstreetlogic.com';

const {
  title,
  description = 'Custom software, automation, and websites for small businesses. Work directly with the developer who builds it.',
  ogImage = '/og/default.png',
  canonicalUrl,
} = Astro.props;

const fullTitle = `${title} | Main Street Logic`;
const canonical = canonicalUrl || new URL(Astro.url.pathname, siteUrl).href;
const absoluteOgImage = ogImage.startsWith('http')
  ? ogImage
  : new URL(ogImage, siteUrl).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="icon"
      href={withBase('/favicon.png')}
      type="image/png"
      sizes="any"
    />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#0f263a" />
    <meta name="generator" content={Astro.generator} />

    <!-- Theme initialization (prevents a flash of the wrong theme) -->
    <script is:inline>
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch (e) {}
        var prefersDark = window.matchMedia(
          '(prefers-color-scheme: dark)'
        ).matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Main Street Logic" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main-content" class="flex-grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>
