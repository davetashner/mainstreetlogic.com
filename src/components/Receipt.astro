---
/**
 * Hero visual: a till receipt itemizing an example week of busywork.
 * The figures are illustrative and labeled as an example.
 */
const lines = [
  { item: 'Retyping orders into QuickBooks', hours: 3 },
  { item: 'Counting stock by hand', hours: 2.5 },
  { item: 'Copying contacts between apps', hours: 2 },
  { item: 'Tracking supply sign-outs', hours: 1.5 },
  { item: 'Chasing unpaid invoices', hours: 1 },
];
const total = lines.reduce((sum, l) => sum + l.hours, 0);
const fmt = (h: number) => `${h.toFixed(1)} h`;
---

<figure
  class="receipt"
  aria-label={`Example receipt: ${total} hours of busywork in one week`}
>
  <div class="paper">
    <p class="head">An example week</p>
    <p class="sub">Hours spent on busywork</p>
    <table>
      <tbody>
        {
          lines.map((l) => (
            <tr>
              <th scope="row">{l.item}</th>
              <td>{fmt(l.hours)}</td>
            </tr>
          ))
        }
      </tbody>
      <tfoot>
        <tr>
          <th scope="row">Total</th>
          <td>{fmt(total)}</td>
        </tr>
      </tfoot>
    </table>
    <p class="foot">Most of this can run on its own.</p>
  </div>
</figure>

<style>
  .receipt {
    --tear: 10px;
    margin: 0;
    width: min(100%, 26rem);
    rotate: -1.5deg;
    filter: drop-shadow(0 1px 1px rgb(12 33 53 / 0.08))
      drop-shadow(0 12px 24px rgb(12 33 53 / 0.12));
  }

  :global(.dark) .receipt {
    filter: drop-shadow(0 12px 28px rgb(0 0 0 / 0.45));
  }

  .paper {
    background: #fffdf6;
    color: #1c2b3b;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    line-height: 1.5;
    padding: 2rem 1.75rem calc(1.5rem + var(--tear));
    /* torn zig-zag bottom edge */
    mask: conic-gradient(
        from -45deg at bottom,
        #0000,
        #000 1deg 89deg,
        #0000 90deg
      )
      50% / calc(2 * var(--tear)) 100%;
  }

  .head,
  .sub,
  .foot {
    text-align: center;
  }

  .head {
    font-weight: 700;
    font-size: 1rem;
  }

  .sub {
    color: #5a6878;
    padding-bottom: 1rem;
    border-bottom: 1.5px dashed #c3ccd5;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin-block: 0.75rem;
  }

  th {
    text-align: left;
    font-weight: 400;
    padding-block: 0.3rem;
    padding-right: 1rem;
  }

  td {
    text-align: right;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    vertical-align: top;
    padding-block: 0.3rem;
  }

  tfoot th,
  tfoot td {
    font-weight: 700;
    font-size: 1.0625rem;
    padding-top: 0.75rem;
    border-top: 1.5px dashed #c3ccd5;
  }

  .foot {
    padding-top: 0.75rem;
    border-top: 1.5px dashed #c3ccd5;
    color: #4d612d;
    font-weight: 700;
  }
</style>
