---
/**
 * Storefront mark: a green shop front under a scalloped yellow awning.
 * Colors are fixed so the mark reads the same in light and dark mode.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 36, class: className } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 40 40"
  class={className}
  aria-hidden="true"
  focusable="false"
>
  <rect x="3" y="6" width="34" height="32" rx="3" fill="#1d4b3b"></rect>
  <path d="M3 9a3 3 0 0 1 3-3h28a3 3 0 0 1 3 3v6H3z" fill="#f0b429"></path>
  <circle cx="7.25" cy="15" r="4.25" fill="#f0b429"></circle>
  <circle cx="15.75" cy="15" r="4.25" fill="#f0b429"></circle>
  <circle cx="24.25" cy="15" r="4.25" fill="#f0b429"></circle>
  <circle cx="32.75" cy="15" r="4.25" fill="#f0b429"></circle>
  <rect x="23" y="24" width="8" height="14" rx="1" fill="#f6f7f2"></rect>
  <rect x="8" y="24" width="11" height="8" rx="1" fill="#f6f7f2" opacity="0.9"
  ></rect>
</svg>
