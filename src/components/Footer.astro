---
import Logo from './Logo.astro';

const year = new Date().getFullYear();

const links = [
  { href: '/services', label: 'Services' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
  {
    href: '/resources/tech-friction-checklist',
    label: 'Tech friction checklist',
  },
  { href: '/blog', label: 'Blog' },
];
---

<footer class="site-footer">
  <div class="wrap grid">
    <div>
      <a href="/" class="brand" aria-label="Main Street Logic, home">
        <Logo height={56} tagline />
      </a>
      <p class="blurb">
        Software, automation, and websites for small businesses. Built by Dave
        Tashner in Central Virginia.
      </p>
    </div>

    <nav aria-label="Footer">
      <ul class="links">
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <p>
        <a href="mailto:hello@mainstreetlogic.com">hello@mainstreetlogic.com</a>
      </p>
      <p class="social">
        <a
          href="https://www.linkedin.com/company/main-street-logic"
          target="_blank"
          rel="noopener noreferrer">LinkedIn</a
        >
        <a
          href="https://github.com/mainstreetlogic"
          target="_blank"
          rel="noopener noreferrer">GitHub</a
        >
      </p>
    </div>
  </div>
  <div class="wrap">
    <div class="ornament" aria-hidden="true"><span></span></div>
    <p class="fine">&copy; {year} Main Street Logic</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--rule);
    background: var(--accent-soft);
    padding-top: 3.5rem;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
  }

  .grid {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 48rem) {
    .grid {
      grid-template-columns: 2fr 1.5fr 1.5fr;
    }
  }

  .brand {
    display: inline-flex;
    text-decoration: none;
  }

  .blurb {
    margin-top: 1.25rem;
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    color: var(--muted);
    max-width: 24em;
  }

  .links {
    display: grid;
    gap: 0.25rem;
  }

  .links a,
  .social a {
    display: inline-block;
    padding-block: 0.375rem;
    color: var(--ink);
    text-decoration: none;
  }

  .links a:hover,
  .social a:hover {
    text-decoration: underline;
  }

  .social {
    display: flex;
    gap: 1.25rem;
    margin-top: 0.5rem;
  }

  .ornament {
    margin-top: 3rem;
  }

  .fine {
    padding-block: 1.25rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }
</style>
