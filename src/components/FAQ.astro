---
import { defaultFaqs, type FaqItem } from '../data/faqs';

interface Props {
  items?: FaqItem[];
}

const { items = defaultFaqs } = Astro.props;
---

<div class="faq ruled">
  {
    items.map((faq) => (
      <details>
        <summary>{faq.question}</summary>
        <div>
          <p>{faq.answer}</p>
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq {
    border-block: 1px solid var(--rule);
  }
</style>
