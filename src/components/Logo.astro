---
import { withBase } from '../lib/url';
/**
 * Main Street Logic logo: storefront illustration + serif wordmark.
 * The illustration swaps for the lamp-lit night version in dark mode.
 * Both are transparent PNG-derived WebPs (929x607), so they sit on any background.
 * The wordmark is live text in Source Serif 4, matching the logo artwork.
 */
interface Props {
  /** Illustration height in px */
  height?: number;
  /** Show the "Technology solutions & custom software" tagline */
  tagline?: boolean;
  class?: string;
}
const { height = 52, tagline = false, class: className } = Astro.props;
const width = Math.round((height * 929) / 607);
---

<span class:list={['logo', className]}>
  <span class="art" style={`width:${width}px;height:${height}px`}>
    <img
      src={withBase('/images/brand/storefront-light.webp')}
      alt=""
      width={width}
      height={height}
      class="light"
    />
    <img
      src={withBase('/images/brand/storefront-dark.webp')}
      alt=""
      width={width}
      height={height}
      class="dark-art"
      loading="lazy"
    />
  </span>
  <span class="type">
    <span class="word">Main Street <span class="logic">Logic</span></span>
    {
      tagline && (
        <span class="tagline">Technology solutions &amp; custom software</span>
      )
    }
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }

  .art {
    position: relative;
    flex-shrink: 0;
  }

  .art img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .dark-art {
    display: none;
  }

  :global(.dark) .light {
    display: none;
  }

  :global(.dark) .dark-art {
    display: block;
  }

  .type {
    display: grid;
    gap: 0.25rem;
  }

  .word {
    font-family: var(--font-serif);
    font-weight: 800;
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: -0.025em;
    color: var(--ink);
    white-space: nowrap;
  }

  .logic {
    color: var(--accent);
  }

  .tagline {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--muted);
  }
</style>
