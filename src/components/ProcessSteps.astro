---
const steps = [
  {
    title: 'Free call',
    description:
      "Thirty minutes by phone or video. You tell me what's slowing you down, and I tell you honestly whether I can help.",
  },
  {
    title: 'Written proposal',
    description:
      "What I'll build, how long it will take, and what it costs, in writing before any work starts.",
  },
  {
    title: 'Build and check in',
    description:
      'You see it working along the way and can change course before anything is final.',
  },
  {
    title: 'Launch and support',
    description:
      'I show your team how it works and stay on for fixes and improvements.',
  },
];
---

<ol class="steps">
  {
    steps.map((step, i) => (
      <li>
        <span class="num" aria-hidden="true">
          {i + 1}
        </span>
        <h3>{step.title}</h3>
        <p>{step.description}</p>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 40rem) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem;
    }
  }

  li {
    border-top: 2px solid var(--ink);
    padding-top: 1rem;
  }

  .num {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 2.75rem;
    line-height: 1;
    color: var(--green);
    margin-bottom: 0.75rem;
  }

  p {
    margin-top: 0.5rem;
    color: var(--muted);
  }
</style>
