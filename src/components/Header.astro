---
import LogoMark from './LogoMark.astro';
import ThemeToggle from './ThemeToggle.astro';

const navItems = [
  { href: '/services', label: 'Services' },
  { href: '/#work', label: 'Work' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/about', label: 'About' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => currentPath === href;
---

<header class="site-header">
  <nav class="wrap" aria-label="Main">
    <div class="bar">
      <a href="/" class="brand">
        <LogoMark size={34} />
        <span>Main Street Logic</span>
      </a>

      <ul class="links">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="actions">
        <ThemeToggle />
        <a href="/contact" class="btn call">Book a call</a>
        <button
          id="menu-button"
          type="button"
          class="menu-button"
          aria-label="Menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </button>
      </div>
    </div>

    <ul id="mobile-menu" class="mobile" hidden>
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li><a href="/contact">Contact</a></li>
    </ul>
  </nav>
</header>
<div class="awning" aria-hidden="true"></div>

<style>
  .site-header {
    background: var(--awning);
    color: #f6f7f2;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: #f6f7f2;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.375rem;
    letter-spacing: -0.005em;
    white-space: nowrap;
  }

  .links {
    display: none;
    gap: 2rem;
    margin-left: auto;
  }

  .links a,
  .mobile a {
    color: #f6f7f2;
    text-decoration: none;
    font-weight: 500;
    font-size: 1.0625rem;
  }

  .links a:hover,
  .links a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: #f0b429;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.4em;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .call {
    display: none;
    min-height: 2.75rem;
    padding: 0.5rem 1.125rem;
    font-size: 1rem;
    margin-left: 0.75rem;
  }

  .menu-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    color: #f6f7f2;
    border-radius: 0.375rem;
  }

  .mobile {
    padding-bottom: 1rem;
  }

  .mobile a {
    display: block;
    padding-block: 0.75rem;
    border-top: 1px solid rgb(246 247 242 / 0.15);
  }

  @media (min-width: 52rem) {
    .links,
    .call {
      display: flex;
    }

    .menu-button,
    .mobile {
      display: none;
    }
  }
</style>

<script>
  const button = document.getElementById('menu-button');
  const menu = document.getElementById('mobile-menu');

  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!open));
    if (menu) menu.hidden = open;
  });
</script>
