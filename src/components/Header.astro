---
import { withBase, withoutBase } from '../lib/url';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';

const navItems = [
  { href: '/services', label: 'Services' },
  { href: '/#work', label: 'Work' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/about', label: 'About' },
];

const currentPath = withoutBase(Astro.url.pathname).replace(/\/$/, '') || '/';
const isCurrent = (href: string) => currentPath === href;
---

<header class="site-header">
  <nav class="wrap" aria-label="Main">
    <div class="bar">
      <a
        href={withBase('/')}
        class="brand"
        aria-label="Main Street Logic, home"
      >
        <Logo height={48} />
      </a>

      <ul class="links">
        {
          navItems.map((item) => (
            <li>
              <a
                href={withBase(item.href)}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="actions">
        <ThemeToggle />
        <a href={withBase('/contact')} class="btn call">Book a call</a>
        <button
          id="menu-button"
          type="button"
          class="menu-button"
          aria-label="Menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </button>
      </div>
    </div>

    <ul id="mobile-menu" class="mobile" hidden>
      {
        navItems.map((item) => (
          <li>
            <a
              href={withBase(item.href)}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li><a href={withBase('/contact')}>Contact</a></li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 5rem;
  }

  .brand {
    display: inline-flex;
    text-decoration: none;
  }

  .links {
    display: none;
    gap: 2rem;
    margin-left: auto;
  }

  .links a,
  .mobile a {
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.9375rem;
  }

  .links a:hover,
  .links a[aria-current='page'] {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.45em;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .call {
    display: none;
    min-height: 2.75rem;
    padding: 0.5rem 1.125rem;
    font-size: 0.9375rem;
    margin-left: 0.75rem;
  }

  .menu-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--ink);
    border-radius: 0.375rem;
  }

  .mobile {
    padding-bottom: 1rem;
  }

  .mobile a {
    display: block;
    padding-block: 0.75rem;
    border-top: 1px solid var(--rule);
    font-size: 1.0625rem;
  }

  /* Phones: a smaller lockup keeps the bar on one line */
  @media (max-width: 30rem) {
    .bar {
      gap: 0.5rem;
    }

    .brand :global(.logo) {
      gap: 0.5rem;
    }

    .brand :global(.word) {
      font-size: 1.25rem;
    }

    .brand :global(.art) {
      width: 72px !important;
      height: 38px !important;
    }
  }

  /* Very narrow phones: wordmark only */
  @media (max-width: 22.5rem) {
    .brand :global(.art) {
      display: none;
    }
  }

  @media (min-width: 56rem) {
    .links,
    .call {
      display: flex;
    }

    .menu-button,
    .mobile {
      display: none;
    }
  }
</style>

<script>
  const button = document.getElementById('menu-button');
  const menu = document.getElementById('mobile-menu');

  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!open));
    if (menu) menu.hidden = open;
  });
</script>
